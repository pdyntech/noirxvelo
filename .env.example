# Copy to .env.local and fill in. Never commit real values.

# Velo (velo-build.dev dashboard)
VELO_API_KEY=
VELO_WEBHOOK_SECRET=

# Stellar Testnet demo wallets (generated by `npm run provision`)
TREASURY_PUBLIC=
TREASURY_SECRET=
SHIPOWNER_PUBLIC=
SHIPOWNER_SECRET=
LP_PUBLIC=
LP_SECRET=
DEBTOR_PUBLIC=
DEBTOR_SECRET=
AGENT_PUBLIC=
AGENT_SECRET=
RELAYER_PUBLIC=
RELAYER_SECRET=

# Agent model (LLM provider)
LLM_API_KEY=

# Public site URL (hosting provider)
APP_URL=

# Event log DB (DB provider)
DATABASE_URL=

# Server (apps/server)
PORT=3000
# Velo checkout asset (handbook example uses "native")
VELO_CHECKOUT_ASSET=native
# Optional: AIS tick interval for the demo, ms
DEMO_TICK_MS=1800
# 1 = in-memory contracts (labelled simulated). Auto-on when wallet keys are missing.
SIMULATE_CHAIN=0
# Optional: model used to phrase agent reasons when LLM_API_KEY is set (Anthropic Messages API)
LLM_MODEL=claude-haiku-5-5
