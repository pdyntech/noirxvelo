DEBTOR_SECRET=
AGENT_PUBLIC=
AGENT_SECRET=
RELAYER_PUBLIC=
RELAYER_SECRET=

# Agent model (LLM provider)
LLM_API_KEY=

# Public site URL (hosting provider)
APP_URL=

# Event log DB (DB provider)
